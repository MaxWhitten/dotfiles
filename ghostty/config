font-family = "source-code-pro"
font-size = 10
window-decoration = true
command = fish
window-padding-balance = true
window-padding-x = 10
window-padding-y = 10
font-style-bold = true
font-style = Boldy
keybind = ctrl+shift+w=new_split:up
keybind = ctrl+shift+s=new_split:down
keybind = ctrl+shift+d=new_split:right
keybind = ctrl+shift+a=new_split:left
keybind = ctrl+shift+n=new_tab
keybind = ctrl+alt+n=new_window
command = TERM=xterm-256color /usr/bin/fish
background-opacity = 0.5
background-blur = true

# Nightfox colors for Ghostty
